rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "azizkayes2005@gmail.com";
    }
    function isApproved() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.status == "approved";
    }
    function canUseApp() {
      return isAdmin() || isApproved();
    }

    // প্রতিটি ব্যবহারকারীর নিজের প্রোফাইল — status ফিল্ড শুধু admin বদলাতে পারবে।
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid &&
        (isAdmin() || request.resource.data.status == "pending");
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == uid &&
         request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /transactions/{id} { allow read, write: if canUseApp(); }
    match /works/{id} { allow read, write: if canUseApp(); }
    match /plans/{id} { allow read, write: if canUseApp(); }
    match /todayUpdates/{id} { allow read, write: if canUseApp(); }
    match /cameras/{id} { allow read, write: if canUseApp(); }
    match /cctvAlerts/{id} { allow read, write: if canUseApp(); }
  }
}
